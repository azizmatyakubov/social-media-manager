  posts Post[]

  @@unique([userId, name])
  @@index([userId, isActive])
}

// ============================================
// CONDITIONAL POSTING
// ============================================

model ConditionalRule {
  id              String        @id @default(cuid())
  userId          String
  name            String
  // Trigger condition
  triggerMetric   String        @default("likes") // likes, retweets, replies, impressions
