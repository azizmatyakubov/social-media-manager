// ============================================

model NotificationSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  postPublished          Boolean  @default(true)
  postFailed             Boolean  @default(true)
  weeklyDigest           Boolean  @default(true)
  engagementAlerts       Boolean  @default(false)
  trendingAlerts         Boolean  @default(false)
  recycleReminders       Boolean  @default(true)
  mentionAlerts          Boolean  @default(true)
  competitorAlerts       Boolean  @default(false)
  digestDay              String   @default("monday")
  digestTime             String   @default("09:00")
  timezone               String   @default("UTC")
  unsubscribedAll        Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

