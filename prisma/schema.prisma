generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Two-Factor Authentication
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?  @db.Text
  twoFactorBackupCodes String[] @default([])

  accounts              Account[]
  sessions              Session[]
  xAccounts             XAccount[]
  linkedInAccounts      LinkedInAccount[]
  instagramAccounts     InstagramAccount[]
  tiktokAccounts        TikTokAccount[]
  youtubeAccounts       YouTubeAccount[]
  pinterestAccounts     PinterestAccount[]
  blueskyAccounts       BlueskyAccount[]
  postingConfig         PostingConfig?
  posts                 Post[]
  threads               Thread[]
  subscription          Subscription?
  voiceProfile          VoiceProfile?
  notificationSettings  NotificationSettings?
  emailNotifications    EmailNotification[]
  contentCalendars      ContentCalendar[]
  workspaceMembers      WorkspaceMember[]
  ownedWorkspaces       Workspace[]
  abTests               ABTest[]
  generatedImages       GeneratedImage[]
  mentions              Mention[]
  competitors           Competitor[]
  dailyMetrics          DailyMetrics[]
  repurposedContent     RepurposedContent[]
  integrations          Integration[]
  activityLogs          ActivityLog[]
  // New features
  inboxMessages         InboxMessage[]
  autoDmRules           AutoDmRule[]
  rssFeeds              RssFeed[]
  contentCategories     ContentCategory[]
  conditionalRules      ConditionalRule[]
  quoteTemplates        QuoteTemplate[]
  aiStrategies          AiStrategy[]
  savedViralTweets      SavedViralTweet[]
  websiteAnalytics      WebsiteAnalytics[]
  brandReports          BrandReport[]
  replyTemplates        ReplyTemplate[]
  linkInBioPages        LinkInBioPage[]
  evergreenSchedules    EvergreenSchedule[]
  utmLinks              UTMLink[]
  utmPresets            UTMPreset[]
  mediaAssets           MediaAsset[]
  mediaFolders          MediaFolder[]
  campaigns             Campaign[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ============================================
// SOCIAL ACCOUNTS - Multi-Platform Support
// ============================================

model XAccount {
  id             String   @id @default(cuid())
  userId         String
  xUserId        String   @unique
  xUsername      String
  accessToken    String   @db.Text
  refreshToken   String?  @db.Text
  tokenExpiresAt DateTime?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

model LinkedInAccount {
  id             String   @id @default(cuid())
  userId         String
  linkedInId     String   @unique
  name           String
  email          String?
  profileUrl     String?
  accessToken    String   @db.Text
  refreshToken   String?  @db.Text
  tokenExpiresAt DateTime?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

model InstagramAccount {
  id              String   @id @default(cuid())
  userId          String
  instagramId     String   @unique
  username        String
  accessToken     String   @db.Text
  tokenExpiresAt  DateTime?
  accountType     String   @default("BUSINESS") // BUSINESS or CREATOR
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

model TikTokAccount {
  id              String   @id @default(cuid())
  userId          String
  tiktokId        String   @unique
  username        String
  displayName     String?
  accessToken     String   @db.Text
  refreshToken    String?  @db.Text
  tokenExpiresAt  DateTime?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

model YouTubeAccount {
  id              String   @id @default(cuid())
  userId          String
  youtubeId       String   @unique
  channelName     String
  channelUrl      String?
  accessToken     String   @db.Text
  refreshToken    String?  @db.Text
  tokenExpiresAt  DateTime?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

model PinterestAccount {
  id              String   @id @default(cuid())
  userId          String
  pinterestId     String   @unique
  username        String
  accessToken     String   @db.Text
  refreshToken    String?  @db.Text
  tokenExpiresAt  DateTime?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

model BlueskyAccount {
  id              String   @id @default(cuid())
  userId          String
  did             String   @unique // Decentralized ID
  handle          String   // e.g., user.bsky.social
  displayName     String?
  accessJwt       String   @db.Text
  refreshJwt      String?  @db.Text
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

// ============================================
// POSTS & CONTENT
// ============================================

model PostingConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  instructions String   @db.Text
  tone         String   @default("professional")
  topics       String[] @default([])
  postingTime  String   @default("09:00")
  timezone     String   @default("UTC")
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id                String     @id @default(cuid())
  userId            String
  workspaceId       String?
  // Multi-platform support
  platform          Platform   @default(X)
  xAccountId        String?
  linkedInAccountId String?
  instagramAccountId String?
  tiktokAccountId   String?
  youtubeAccountId  String?
  pinterestAccountId String?
  blueskyAccountId  String?
  // Thread support
  threadId          String?
  threadIndex       Int?
  // Content
  content           String     @db.Text
  platformPostId    String?    // ID from the platform (xPostId, linkedInPostId, etc.)
  status            PostStatus @default(PENDING)
  error             String?    @db.Text
  scheduledFor      DateTime?
  postedAt          DateTime?
  // Engagement metrics
  likes             Int        @default(0)
  retweets          Int        @default(0)
  replies           Int        @default(0)
  impressions       Int        @default(0)
  shares            Int        @default(0)
  clicks            Int        @default(0)
  // Viral prediction score (0-100)
  viralScore        Int?
  // Evergreen recycling
  isEvergreen       Boolean    @default(false)
  lastRecycled      DateTime?
  recycleCount      Int        @default(0)
  autoRetweet       Boolean    @default(false) // Auto-retweet when engagement threshold met
  // Media
  mediaUrls         String[]   @default([])
  mediaType         MediaType?
  // A/B Testing
  abTestId          String?
  abVariant         String?    // "A", "B", "C", etc.
  // Content Category
  categoryId        String?
  // Approval workflow
  approvalStatus    ApprovalStatus @default(APPROVED)
  approvedBy        String?
  approvedAt        DateTime?
  // Conditional posting
  conditionalRuleId String?
  // Timestamps
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  xAccount         XAccount?         @relation(fields: [xAccountId], references: [id])
  linkedInAccount  LinkedInAccount?  @relation(fields: [linkedInAccountId], references: [id])
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id])
  tiktokAccount    TikTokAccount?    @relation(fields: [tiktokAccountId], references: [id])
  youtubeAccount   YouTubeAccount?   @relation(fields: [youtubeAccountId], references: [id])
  pinterestAccount PinterestAccount? @relation(fields: [pinterestAccountId], references: [id])
  blueskyAccount   BlueskyAccount?   @relation(fields: [blueskyAccountId], references: [id])
  thread           Thread?           @relation(fields: [threadId], references: [id])
  abTest           ABTest?           @relation(fields: [abTestId], references: [id])
  category         ContentCategory?  @relation(fields: [categoryId], references: [id])
  conditionalRule  ConditionalRule?  @relation(fields: [conditionalRuleId], references: [id])
  approvalRequest  ApprovalRequest?

  @@index([status, scheduledFor])
  @@index([userId, isEvergreen])
  @@index([categoryId])
  @@index([threadId])
  @@index([platform, status])
  @@index([workspaceId])
  @@index([abTestId])
}

model Thread {
  id          String       @id @default(cuid())
  userId      String
  title       String?
  status      PostStatus   @default(PENDING)
  scheduledFor DateTime?
  postedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId, status])
}

model VoiceProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  avgSentenceLen  Float?
  avgWordLen      Float?
  emojiUsage      Float?
  hashtagUsage    Float?
  questionUsage   Float?
  exclamationUse  Float?
  commonPhrases   String[] @default([])
  commonEmojis    String[] @default([])
  commonHashtags  String[] @default([])
  toneKeywords    String[] @default([])
  styleAnalysis   String?  @db.Text
  samplePosts     String[] @default([])
  postsAnalyzed   Int      @default(0)
  lastAnalyzed    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrendCache {
  id        String   @id @default(cuid())
  category  String
  trends    Json
  region    String   @default("US")
  fetchedAt DateTime @default(now())

  @@unique([category, region])
  @@index([fetchedAt])
}

// ============================================
// AI CONTENT CALENDAR
// ============================================

model ContentCalendar {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  name        String   @default("My Calendar")
  description String?
  timezone    String   @default("UTC")
  isActive    Boolean  @default(true)
  // Auto-generation settings
  autoGenerate      Boolean  @default(false)
  postsPerDay       Int      @default(3)
  preferredTimes    String[] @default(["09:00", "13:00", "18:00"])
  contentThemes     String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id])
  slots       CalendarSlot[]

  @@index([userId])
  @@index([workspaceId])
}

model CalendarSlot {
  id           String       @id @default(cuid())
  calendarId   String
  date         DateTime
  time         String       // "HH:mm" format
  platform     Platform     @default(X)
  // Content
  content      String?      @db.Text
  suggestedContent String?  @db.Text // AI-generated suggestion
  contentTheme String?
  // Status
  status       SlotStatus   @default(EMPTY)
  postId       String?      // Link to actual post when published
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  calendar ContentCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId, date])
  @@index([date, status])
}

// ============================================
// TEAM COLLABORATION
// ============================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String
  logo        String?
  // Settings
  requireApproval Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  posts           Post[]
  calendars       ContentCalendar[]
  approvalRequests ApprovalRequest[]
  activityLogs    ActivityLog[]
  webhooks        Webhook[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  workspaceId String
  postId      String
  requesterId String
  status      ApprovalStatus @default(PENDING)
  reviewerId  String?
  reviewedAt  DateTime?
  comment     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([requesterId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  action      String   // "post.created", "post.published", "member.invited", etc.
  entityType  String   // "post", "member", "settings", etc.
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

// ============================================
// A/B TESTING
// ============================================

model ABTest {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  platform    Platform     @default(X)
  status      ABTestStatus @default(DRAFT)
  // Test configuration
  metric      String       @default("engagement") // engagement, clicks, impressions
  duration    Int          @default(24) // hours
  // Results
  winnerId    String?      // ID of winning variant post
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants ABTestVariant[]
  posts    Post[]

  @@index([userId, status])
}

model ABTestVariant {
  id        String   @id @default(cuid())
  testId    String
  name      String   // "A", "B", "C"
  content   String   @db.Text
  mediaUrls String[] @default([])
  // Results
  impressions Int    @default(0)
  engagements Int    @default(0)
  clicks      Int    @default(0)
  createdAt DateTime @default(now())

  test ABTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

// ============================================
// AI IMAGE GENERATION
// ============================================

model GeneratedImage {
  id          String   @id @default(cuid())
  userId      String
  prompt      String   @db.Text
  revisedPrompt String? @db.Text
  imageUrl    String
  size        String   @default("1024x1024")
  style       String   @default("vivid") // vivid or natural
  model       String   @default("dall-e-3")
  // Usage tracking
  postId      String?  // If used in a post
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================
// SMART REPLY ASSISTANT
// ============================================

model Mention {
  id          String        @id @default(cuid())
  userId      String
  platform    Platform      @default(X)
  platformId  String        // ID of the mention/reply on platform
  authorId    String        // Platform user ID of author
  authorName  String
  authorUsername String
  content     String        @db.Text
  inReplyTo   String?       // If this is a reply to user's post
  sentiment   Sentiment?
  status      MentionStatus @default(UNREAD)
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SuggestedReply[]

  @@unique([platform, platformId])
  @@index([userId, status])
  @@index([createdAt])
}

model SuggestedReply {
  id        String   @id @default(cuid())
  mentionId String
  content   String   @db.Text
  tone      String   @default("friendly") // friendly, professional, witty, etc.
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  mention Mention @relation(fields: [mentionId], references: [id], onDelete: Cascade)

  @@index([mentionId])
}

model ReplyTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  content     String   @db.Text
  category    String   @default("general") // general, support, sales, thanks, greeting
  shortcut    String?  // Keyboard shortcut like "/thanks"
  variables   String[] @default([]) // Variables like {name}, {product}
  tone        String   @default("friendly")
  platform    Platform?
  usedCount   Int      @default(0)
  lastUsedAt  DateTime?
  isFavorite  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortcut])
  @@index([userId, category])
  @@index([userId, isFavorite])
}

// ============================================
// LINK-IN-BIO
// ============================================

model LinkInBioPage {
  id              String   @id @default(cuid())
  userId          String
  slug            String   @unique // e.g., "johndoe" -> autopost.com/l/johndoe
  title           String
  bio             String?  @db.Text
  // Profile
  avatarUrl       String?
  backgroundImage String?
  // Theme/Styling
  theme           String   @default("default") // default, minimal, gradient, dark, neon
  primaryColor    String   @default("#6366F1")
  secondaryColor  String   @default("#8B5CF6")
  backgroundColor String   @default("#000000")
  textColor       String   @default("#FFFFFF")
  buttonStyle     String   @default("rounded") // rounded, pill, square
  fontFamily      String   @default("Inter")
  // Social links (displayed as icons)
  socialLinks     Json?    // { twitter: "url", instagram: "url", ... }
  // Analytics
  totalViews      Int      @default(0)
  totalClicks     Int      @default(0)
  // SEO
  metaTitle       String?
  metaDescription String?  @db.Text
  // Status
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  links LinkInBioLink[]

  @@index([userId])
  @@index([slug])
}

model LinkInBioLink {
  id          String   @id @default(cuid())
  pageId      String
  title       String
  url         String
  icon        String?  // Icon name or emoji
  thumbnail   String?  // Thumbnail image URL
  position    Int      @default(0)
  // Analytics
  clicks      Int      @default(0)
  // Scheduling
  isVisible   Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  // Status
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page LinkInBioPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
}

// ============================================
// COMPETITOR TRACKING
// ============================================

model Competitor {
  id          String   @id @default(cuid())
  userId      String
  platform    Platform @default(X)
  platformId  String   // Their platform user ID
  username    String
  name        String?
  profileUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]

  @@unique([userId, platform, platformId])
  @@index([userId, isActive])
}

model CompetitorSnapshot {
  id           String   @id @default(cuid())
  competitorId String
  // Metrics at snapshot time
  followers    Int      @default(0)
  following    Int      @default(0)
  totalPosts   Int      @default(0)
  // Recent engagement (last 30 days average)
  avgLikes     Float    @default(0)
  avgRetweets  Float    @default(0)
  avgReplies   Float    @default(0)
  engagementRate Float  @default(0)
  // Top posts
  topPosts     Json?    // Array of recent high-performing posts
  // Posting patterns
  postsPerDay  Float    @default(0)
  peakHours    Int[]    @default([])
  topHashtags  String[] @default([])
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, createdAt])
}

// ============================================
// ADVANCED ANALYTICS
// ============================================

model DailyMetrics {
  id          String   @id @default(cuid())
  userId      String
  platform    Platform @default(X)
  date        DateTime @db.Date
  // Growth
  followers   Int      @default(0)
  following   Int      @default(0)
  followerChange Int   @default(0)
  // Engagement
  totalLikes       Int @default(0)
  totalRetweets    Int @default(0)
  totalReplies     Int @default(0)
  totalImpressions Int @default(0)
  totalClicks      Int @default(0)
  // Content
  postsPublished   Int @default(0)
  engagementRate   Float @default(0)
  // Best performing
  topPostId   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, date])
  @@index([userId, date])
}

// ============================================
// CONTENT REPURPOSING
// ============================================

model RepurposedContent {
  id             String         @id @default(cuid())
  userId         String
  // Source
  sourceType     ContentType
  sourceContent  String         @db.Text
  sourcePostId   String?
  // Output
  outputType     ContentType
  outputContent  String         @db.Text
  outputPlatform Platform?
  // Status
  status         RepurposeStatus @default(DRAFT)
  postId         String?        // If published
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================
// INTEGRATION HUB
// ============================================

model Integration {
  id          String          @id @default(cuid())
  userId      String
  workspaceId String?
  type        IntegrationType
  name        String
  // OAuth/API credentials
  accessToken String?         @db.Text
  refreshToken String?        @db.Text
  apiKey      String?         @db.Text
  // Configuration
  config      Json?
  isActive    Boolean         @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, isActive])
}

model Webhook {
  id          String        @id @default(cuid())
  workspaceId String?
  name        String
  url         String
  secret      String        // For signature verification
  events      String[]      // ["post.published", "post.failed", etc.]
  isActive    Boolean       @default(true)
  lastTriggeredAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs        WebhookEvent[]

  @@index([workspaceId, isActive])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  status      Int      // HTTP status code
  response    String?  @db.Text
  attempts    Int      @default(1)
  createdAt   DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

// ============================================
// UNIFIED SOCIAL INBOX
// ============================================

model InboxMessage {
  id              String        @id @default(cuid())
  userId          String
  platform        Platform
  // Message details
  messageType     MessageType   @default(COMMENT)
  platformId      String        // Platform's message ID
  conversationId  String?       // For threading DMs
  // Author info
  authorId        String
  authorName      String
  authorUsername  String
  authorAvatar    String?
  // Content
  content         String        @db.Text
  mediaUrls       String[]      @default([])
  // Reference to user's post (if comment/reply)
  postId          String?
  postContent     String?       @db.Text
  // Status
  status          InboxStatus   @default(UNREAD)
  sentiment       Sentiment?
  isSpam          Boolean       @default(false)
  // Labels/Tags for organization
  labels          String[]      @default([])
  assignedTo      String?       // Team member assigned
  // Response
  repliedAt       DateTime?
  replyContent    String?       @db.Text
  // Timestamps
  receivedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, platformId])
  @@index([userId, status])
  @@index([userId, platform])
  @@index([receivedAt])
  @@index([conversationId])
}

// ============================================
// AUTO DM ON KEYWORD
// ============================================

model AutoDmRule {
  id              String        @id @default(cuid())
  userId          String
  name            String
  // Trigger settings
  triggerType     TriggerType   @default(KEYWORD_COMMENT)
  keywords        String[]      // Keywords to trigger on
